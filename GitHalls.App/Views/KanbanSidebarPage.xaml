<Page
    x:Class="GitHalls.App.Views.KanbanSidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitHalls.App.Views"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The queries are the navigation: pick one and the board runs it.
             Presets first, then the user's own, as sections of one list — the
             same shape as the branch picker. -->
        <ListView x:Name="QueryList" Grid.Row="0"
                  SelectionMode="Single"
                  SelectionChanged="QueryList_SelectionChanged"
                  ContainerContentChanging="QueryList_ContainerContentChanging"
                  RightTapped="QueryList_RightTapped"
                  Style="{StaticResource GHListViewStyle}"
                  ItemContainerStyle="{StaticResource GHListItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:QueryRow">
                    <Grid Padding="0,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"
                                  Glyph="{x:Bind Glyph}" VerticalAlignment="Center"
                                  Visibility="{x:Bind GlyphVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <TextBlock Text="{x:Bind Title}"
                                       FontSize="{x:Bind FontSize}"
                                       FontWeight="{x:Bind FontWeight}"
                                       Style="{x:Bind TitleStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource GHCaptionTextStyle}"
                                       Visibility="{x:Bind SubtitleVisibility}" MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Not connected: nothing to query yet. -->
        <StackPanel x:Name="StatePanel" Grid.Row="0" Spacing="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Border Style="{StaticResource GHEmptyStateTileStyle}"
                    Background="{ThemeResource GHKanbanTintBrush}">
                <FontIcon Glyph="&#xE71B;" FontSize="22" Foreground="{ThemeResource GHKanbanBrush}" />
            </Border>
            <TextBlock Text="No Jira account connected yet."
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Open Settings" HorizontalAlignment="Center" Click="Connect_Click" />
        </StackPanel>

        <Button x:Name="AddQueryButton" Grid.Row="1" Margin="12,0,12,12" HorizontalAlignment="Stretch"
                Click="AddQuery_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE710;" />
                <TextBlock Text="Add query" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
