<Page
    x:Class="GitHalls.App.Views.CommitDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls"
    xmlns:converters="using:GitHalls.App.Converters"
    xmlns:models="using:GitHalls.Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Page.Resources>
        <converters:FileStatusToBrushConverter x:Key="StatusBrush" />
        <converters:FileStatusToBrushConverter x:Key="StatusTint" Tint="True" />
    </Page.Resources>

    <Grid>
        <!-- Empty / loading states, mirroring the Swift ContentUnavailableView -->
        <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <Border Style="{StaticResource GHEmptyStateTileStyle}"
                    Background="{ThemeResource GHHistoryTintBrush}">
                <FontIcon Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource GHHistoryBrush}" />
            </Border>
            <TextBlock x:Name="PlaceholderText" Text="Select a commit"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- No pane-wide spinner: the header appears with the selection, and the
             file list says for itself that it is still loading. -->
        <Grid x:Name="DetailRoot" Visibility="Collapsed" Padding="12,4,12,12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The commit itself reads as one Settings card: title, muted
                 supporting line, optional body. -->
            <StackPanel Grid.Row="0" Style="{StaticResource GHCardPanelStyle}"
                        Spacing="6" Padding="16,12">
                <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="AuthorText" Style="{StaticResource GHCaptionTextStyle}" />
                    <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="DateText" Style="{StaticResource GHCaptionTextStyle}" />
                    <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="HashText" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Files on the left, the diff beside them: a commit that touches
                 thirty files should not push its own diff off the bottom. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilesColumn" Width="280" MinWidth="200" MaxWidth="520" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- The file list carries no diffs. Picking a row is what fetches
                     one, which is the whole reason opening a commit is instant. -->
                <Border Grid.Column="0" Style="{StaticResource GHContentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="FilesHeaderText" Grid.Row="0" Margin="14,10,14,0"
                                   Style="{StaticResource GHSectionHeaderTextStyle}" />

                        <ListView x:Name="FilesList" Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.CommitFiles, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCommitFile, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Style="{StaticResource GHListViewStyle}"
                                  ItemContainerStyle="{StaticResource GHListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CommitFile">
                                    <Grid Padding="0,2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource GHStatusBadgeStyle}"
                                                Background="{x:Bind Status, Converter={StaticResource StatusTint}}">
                                            <TextBlock Text="{x:Bind BadgeLetter}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="{x:Bind Path}">
                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{x:Bind DirectoryPath}" Style="{StaticResource GHCaptionTextStyle}" MaxLines="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AdditionsText}" FontSize="12" Foreground="{ThemeResource GHAdditionBrush}" />
                                            <TextBlock Text="{x:Bind DeletionsText}" FontSize="12" Foreground="{ThemeResource GHDeletionBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <toolkit:GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                                      ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment" />

                <!-- One diff at a time: the file that is selected, nothing else. -->
                <Border Grid.Column="2" Style="{StaticResource GHContentCardStyle}">
                    <Grid>
                        <controls:DiffViewer x:Name="DiffView" Visibility="Collapsed" />

                        <TextBlock x:Name="DiffPlaceholderText" Text="Select a file to see its changes."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <ProgressRing x:Name="DiffLoadingRing" IsActive="False" Visibility="Collapsed"
                                      Width="24" Height="24"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
