<Page
    x:Class="GitHalls.App.Views.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="FilePathText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="AdditionsText" Foreground="#4CAF50" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="DeletionsText" Foreground="#F44336" FontWeight="Bold" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </Border>

        <controls:DiffTextView x:Name="DiffView" Grid.Row="1" />

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="Select a file to see its changes."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
