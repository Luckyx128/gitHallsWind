<Page
    x:Class="GitHalls.App.Views.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitHalls.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <TextBlock Text="{x:Bind FilePath, Mode=OneWay}" FontWeight="Bold" />
        </Border>

        <!-- Diff Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto">
            <ListView ItemsSource="{x:Bind DiffLines, Mode=OneWay}"
                      SelectionMode="None"
                      FontFamily="Consolas"
                      FontSize="13">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="20"/>
                        <Setter Property="Padding" Value="4,0,12,0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiffLine">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind OldLineNumber}" Foreground="Gray" TextAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind NewLineNumber}" Foreground="Gray" TextAlignment="Right" Margin="0,0,16,0" />
                            
                            <!-- Note: Real highlighting would use the SyntaxHighlighter service, 
                                 but for this phase we'll just display the text directly. -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Content}" TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
