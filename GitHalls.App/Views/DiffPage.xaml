<Page
    x:Class="GitHalls.App.Views.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page title over the content, the way a Settings page names itself:
             no panel behind it and no rule under it. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="14,10,14,8">
            <TextBlock x:Name="FilePathText" Style="{StaticResource GHPaneTitleTextStyle}" VerticalAlignment="Center" />
            <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="AdditionsText" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="DeletionsText" Foreground="#F44336" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <!-- The diff itself is the card floating on the window's Mica. -->
        <Border x:Name="DiffCard" Grid.Row="1" Style="{StaticResource GHContentCardStyle}" Margin="12,0,12,12">
            <controls:DiffTextView x:Name="DiffView" />
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="Select a file to see its changes."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
