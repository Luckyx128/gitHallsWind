<Page
    x:Class="GitHalls.App.Views.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page title over the content, the way a Settings page names itself:
             no panel behind it and no rule under it. -->
        <Grid Grid.Row="0" Padding="14,10,14,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="FilePathText" Style="{StaticResource GHPaneTitleTextStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="AdditionsText" Foreground="{ThemeResource GHAdditionBrush}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="DeletionsText" Foreground="{ThemeResource GHDeletionBrush}" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- Which side of the file is on screen. The two are separate diffs
                 because only the one against the index can be staged from. -->
            <StackPanel x:Name="SidePanel" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <!-- An untracked file has no patch behind it, so its lines
                     cannot be picked apart. Said once, next to the toggle,
                     rather than as a bar over the code. -->
                <TextBlock x:Name="WholeFileHint" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"
                           Text="Stage the file to pick lines"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleButton x:Name="UnstagedToggle" MinWidth="0" Padding="10,3" CornerRadius="4"
                              FontSize="12" Click="SideToggle_Click" Tag="WorkingTree" />
                <ToggleButton x:Name="StagedToggle" MinWidth="0" Padding="10,3" CornerRadius="4"
                              FontSize="12" Click="SideToggle_Click" Tag="Index" />
            </StackPanel>
        </Grid>

        <!-- The diff itself is the card floating on the window's Mica. -->
        <Border x:Name="DiffCard" Grid.Row="1" Style="{StaticResource GHContentCardStyle}" Margin="12,0,12,12">
            <controls:DiffViewer x:Name="DiffView" />
        </Border>

        <!-- Floats over the diff rather than taking a row of its own: it is only
             there while something is picked, and a row appearing and vanishing
             would shift the code under the pointer mid-drag. -->
        <Border x:Name="SelectionBar" Grid.Row="1" Style="{StaticResource GHCardStyle}"
                Visibility="Collapsed" Padding="10,6"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ApplySelectionButton" Style="{StaticResource AccentButtonStyle}"
                        FontSize="12" Padding="12,4" MinHeight="0" Click="ApplySelection_Click" />
                <Button Content="Clear" FontSize="12" Padding="10,4" MinHeight="0" Click="ClearSelection_Click" />
            </StackPanel>
        </Border>

        <!-- Nothing selected is the moment the repository is opened and the
             moment a branch is switched into — which is exactly when its README
             is worth reading. -->
        <Border x:Name="ReadmeCard" Grid.Row="1" Style="{StaticResource GHContentCardStyle}"
                Margin="12,0,12,12" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ReadmeNameText" Style="{StaticResource GHCaptionTextStyle}" />
                    <controls:MarkdownView x:Name="ReadmeView" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="Select a file to see its changes."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
