<Page
    x:Class="GitHalls.App.Views.ChangesSidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitHalls.Core.Models"
    xmlns:viewmodels="using:GitHalls.App.ViewModels"
    xmlns:converters="using:GitHalls.App.Converters"
    x:Name="PageRoot"
    Background="Transparent">

    <Page.Resources>
        <converters:StringToBrushConverter x:Key="ColorConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Global Stage Checkbox -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
            <CheckBox Content="Stage All Changes" Command="{x:Bind ViewModel.StageAllCommand}" />
        </Border>

        <!-- List of changes -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}" 
                  SelectedItem="{x:Bind ViewModel.SelectedChange, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileChange">
                    <Grid Padding="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsStaged, Mode=OneWay}" 
                                  Click="ChangeCheckBox_Click" Tag="{x:Bind}" Margin="0,0,8,0" MinWidth="0" />
                        
                        <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind DirectoryPath}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Badge -->
                        <Border Grid.Column="2" Background="{x:Bind BadgeColorHex, Converter={StaticResource ColorConverter}}" 
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind BadgeLetter}" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Commit Panel Mock -->
        <StackPanel Grid.Row="2" Padding="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBox x:Name="CommitMessageTextBox" PlaceholderText="Commit message" AcceptsReturn="True" Height="80" />
            <Button Content="Commit" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="CommitButton_Click" />
        </StackPanel>
    </Grid>
</Page>
