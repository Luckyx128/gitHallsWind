<Page
    x:Class="GitHalls.App.Views.ChangesSidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitHalls.Core.Models"
    xmlns:converters="using:GitHalls.App.Converters"
    x:Name="PageRoot"
    Background="Transparent">

    <Page.Resources>
        <converters:StringToBrushConverter x:Key="ColorConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6,8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Three-state: checked = all staged, indeterminate = some, unchecked = none. -->
                <CheckBox x:Name="StageAllCheckBox" Grid.Column="0"
                          Content="Stage All Changes"
                          IsThreeState="True"
                          IsChecked="{x:Bind ViewModel.StagedState, Mode=OneWay}"
                          Click="StageAllCheckBox_Click"
                          VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Width="32" Height="32" Padding="0"
                        IsEnabled="{x:Bind ViewModel.HasSelectedChange, Mode=OneWay}"
                        Click="DiscardButton_Click"
                        ToolTipService.ToolTip="Discard changes in the selected file" />
            </Grid>
        </Border>

        <ListView x:Name="ChangesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedChange, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ContextFlyout>
                <MenuFlyout Opening="ChangesContextFlyout_Opening">
                    <MenuFlyoutItem x:Name="DiscardMenuItem" Text="Discard Changes..." Click="DiscardMenuItem_Click" />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileChange">
                    <Grid Padding="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsStaged, Mode=OneWay}"
                                  Click="ChangeCheckBox_Click" Tag="{x:Bind}" Margin="0,0,8,0" MinWidth="0" />

                        <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                    ToolTipService.ToolTip="{x:Bind Path}">
                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind DirectoryPath}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{x:Bind BadgeColorHex, Converter={StaticResource ColorConverter}}"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind BadgeLetter}" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Padding="12" Spacing="8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">

            <!-- Conventional Commits: the type and scope build the "type(scope): "
                 prefix of the summary, so the text stays editable by hand. -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CommitTypeComboBox" Grid.Column="0"
                          PlaceholderText="type" HorizontalAlignment="Stretch" Height="32"
                          SelectionChanged="CommitTypeComboBox_SelectionChanged" />

                <TextBox x:Name="CommitScopeTextBox" Grid.Column="1"
                         PlaceholderText="scope" Height="32"
                         Text="{x:Bind ViewModel.CommitScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         LostFocus="CommitScope_Committed" KeyDown="CommitScope_KeyDown" />

                <Button Grid.Column="2" Width="32" Height="32" Padding="0"
                        Content="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        ToolTipService.ToolTip="Conventional Commits reference">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel x:Name="CommitTypeReference" Spacing="10" Width="300" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SuggestButton" Grid.Column="3" Height="32"
                        Content="Suggest" Click="SuggestButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasStagedChanges, Mode=OneWay}"
                        ToolTipService.ToolTip="Guess the type and scope from the staged files" />
            </Grid>

            <TextBox x:Name="CommitSummaryTextBox"
                     PlaceholderText="Summary"
                     Text="{x:Bind ViewModel.CommitSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox x:Name="CommitDescriptionTextBox"
                     PlaceholderText="Description (optional)"
                     AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                     Text="{x:Bind ViewModel.CommitDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button x:Name="CommitButton" Content="Commit" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CommitCommand}" />
        </StackPanel>
    </Grid>
</Page>
