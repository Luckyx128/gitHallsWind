<Window
    x:Class="GitHalls.App.Views.IssueWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Issue">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock x:Name="TitleBarText" Text="Issue" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" Padding="16,4,16,16">

                <!-- MARK: The issue -->
                <StackPanel Spacing="10" Padding="16,14" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="KeyText" Grid.Column="0" FontFamily="Cascadia Mono, Consolas"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />

                        <!-- Still the 3px badge, and now the way to move the
                             issue: the status is the thing you want to change
                             while looking at it. -->
                        <DropDownButton x:Name="StatusButton" Grid.Column="1" CornerRadius="3" Padding="6,1"
                                        MinWidth="0" MinHeight="0" BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        ToolTipService.ToolTip="Move this issue">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="StatusMenu" Opening="StatusMenu_Opening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button x:Name="OpenInJiraButton" Grid.Column="3" Content="Open in Jira" Height="28"
                                Padding="10,0" Click="OpenInJira_Click" />
                    </Grid>

                    <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <!-- Label / value pairs, the way Settings lists a device's details. -->
                    <Grid x:Name="MetaGrid" ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TypeText" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Priority" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PriorityText" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Assignee" Style="{StaticResource GHCaptionTextStyle}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="AssigneeText" FontSize="12" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="AssignToMeButton" Content="Assign to me"
                                             FontSize="12" Padding="0" MinHeight="0"
                                             Click="AssignToMe_Click" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Reporter" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ReporterText" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Created" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CreatedText" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Updated" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UpdatedText" FontSize="12" />
                    </Grid>

                    <ItemsControl x:Name="LabelsList" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource GHChipStyle}" Padding="8,2">
                                    <TextBlock Text="{x:Bind}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- MARK: Description -->
                <StackPanel Spacing="8" Padding="16,14" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="Description" Style="{StaticResource GHSectionHeaderTextStyle}" />
                        <ProgressRing x:Name="DescriptionRing" Width="16" Height="16" IsActive="False"
                                      Visibility="Collapsed" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               LineHeight="20" />

                    <InfoBar x:Name="DescriptionInfoBar" IsOpen="False" IsClosable="False" Severity="Error" />
                </StackPanel>

                <!-- MARK: Branch — the one place Jira and git meet. -->
                <StackPanel Spacing="8" Padding="16,14" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock Text="Create a branch from this issue" Style="{StaticResource GHSectionHeaderTextStyle}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Suggested, never imposed: the name is editable before
                             anything is created. -->
                        <TextBox x:Name="BranchNameTextBox" Grid.Column="0" Height="32"
                                 PlaceholderText="Branch name"
                                 TextChanged="BranchName_TextChanged"
                                 KeyDown="BranchName_KeyDown" />

                        <Button x:Name="ResetNameButton" Grid.Column="1" Width="32" Height="32" Padding="0"
                                Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Click="ResetName_Click"
                                ToolTipService.ToolTip="Back to the suggested name" />

                        <Button x:Name="CreateBranchButton" Grid.Column="2" Height="32"
                                Content="Create Branch"
                                Click="CreateBranch_Click" />

                        <!-- Three things in one click, so the tooltip says all three. -->
                        <Button x:Name="StartWorkButton" Grid.Column="3" Height="32"
                                Content="Start Work"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="StartWork_Click"
                                ToolTipService.ToolTip="Creates the branch, assigns the issue to you, and moves it to the in-progress status." />
                    </Grid>

                    <TextBlock x:Name="TargetRepositoryText" Style="{StaticResource GHCaptionTextStyle}"
                               TextWrapping="Wrap" />

                    <InfoBar x:Name="ActionInfoBar" IsOpen="False" IsClosable="True" Severity="Success"
                             CloseButtonClick="ActionInfoBar_CloseButtonClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
