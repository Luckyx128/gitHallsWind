<Page
    x:Class="GitHalls.App.Views.KanbanBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Left edge lines up with the cards below it (12px). -->
        <Grid Grid.Row="0" Padding="12,4,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="QueryTitleText" Style="{StaticResource GHPaneTitleTextStyle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource GHCaptionTextStyle}" />
            </StackPanel>

            <!-- Narrows what is already on the board; never asks Jira. -->
            <TextBox x:Name="FilterTextBox" Grid.Column="1" Width="220" Height="32"
                     PlaceholderText="Filter cards"
                     TextChanged="FilterTextBox_TextChanged" />

            <ProgressRing x:Name="LoadingRing" Grid.Column="2" Width="18" Height="18"
                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />

            <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                    Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="Run the query again" />
        </Grid>

        <!-- What the last move or assign did. The empty state below can't say
             it: that one is hidden whenever the board has columns, which is
             exactly when a write happens. -->
        <InfoBar x:Name="ActionInfoBar" Grid.Row="1" Margin="12,0,12,8"
                 IsOpen="False" IsClosable="True" Severity="Success"
                 CloseButtonClick="ActionInfoBar_CloseButtonClick" />

        <!-- Columns scroll sideways as one strip; each column scrolls its own
             cards. The strip is as tall as the pane, so the columns are too. -->
        <ScrollViewer x:Name="BoardScroller" Grid.Row="2"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal" Spacing="12"
                        Padding="12,0,12,12" VerticalAlignment="Stretch" />
        </ScrollViewer>

        <!-- Not connected / error / nothing found, one at a time. -->
        <StackPanel x:Name="StatePanel" Grid.Row="2" Spacing="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="StateGlyph" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="StateText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ConnectButton" Content="Open Settings" HorizontalAlignment="Center"
                    Click="Connect_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
