<Page
    x:Class="GitHalls.App.Views.IssueDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Select an issue"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer x:Name="DetailScroller" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" Padding="12,4,12,12">

                <!-- The issue itself, as one card. -->
                <StackPanel Spacing="8" Padding="16,12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="KeyText" FontFamily="Cascadia Mono, Consolas"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="OpenInJiraButton" Content="Open in Jira" Height="28"
                                Padding="10,0" Click="OpenInJira_Click" />
                    </StackPanel>

                    <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="StatusText" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TypeText" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock x:Name="PrioritySeparator" Text="·" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="PriorityText" Style="{StaticResource GHCaptionTextStyle}" />
                        <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="UpdatedText" Style="{StaticResource GHCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- The one place Jira and git meet. -->
                <StackPanel Spacing="8" Padding="16,12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock Text="Create a branch from this issue" Style="{StaticResource GHSectionHeaderTextStyle}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Suggested, never imposed: the name is editable before
                             anything is created. -->
                        <TextBox x:Name="BranchNameTextBox" Grid.Column="0" Height="32"
                                 PlaceholderText="Branch name"
                                 TextChanged="BranchName_TextChanged"
                                 KeyDown="BranchName_KeyDown" />

                        <Button x:Name="ResetNameButton" Grid.Column="1" Width="32" Height="32" Padding="0"
                                Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Click="ResetName_Click"
                                ToolTipService.ToolTip="Back to the suggested name" />

                        <Button x:Name="CreateBranchButton" Grid.Column="2" Height="32"
                                Content="Create Branch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="CreateBranch_Click" />
                    </Grid>

                    <TextBlock x:Name="TargetRepositoryText" Style="{StaticResource GHCaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
