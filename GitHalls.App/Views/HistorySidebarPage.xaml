<Page
    x:Class="GitHalls.App.Views.HistorySidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls"
    xmlns:converters="using:GitHalls.App.Converters"
    xmlns:graph="using:GitHalls.Core.Graph"
    x:Name="PageRoot"
    Background="Transparent">

    <Page.Resources>
        <converters:RefToBackgroundConverter x:Key="RefToBackgroundConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="BranchFilterBar" Grid.Row="0"
                     SelectionChanged="BranchFilterBar_SelectionChanged"
                     Margin="8,4,8,4" HorizontalAlignment="Left">
            <SelectorBarItem x:Name="AllBranchesItem" Text="All branches" />
            <SelectorBarItem x:Name="CurrentBranchItem" Text="Current branch" />
        </SelectorBar>

        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.GitgraphViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ToVisibility(ViewModel.GitgraphViewModel.IsLoading), Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.GitgraphViewModel.ErrorMessage, Mode=OneWay}"
                   Foreground="Red"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ToErrorVisibility(ViewModel.GitgraphViewModel.ErrorMessage), Mode=OneWay}" />

        <ListView x:Name="HistoryList" Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.GitgraphViewModel.Rows, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.GitgraphViewModel.SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single"
                  ShowsScrollingPlaceholders="False"
                  Style="{StaticResource GHListViewStyle}"
                  ItemContainerStyle="{StaticResource GHHistoryListItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="graph:GraphRow">
                    <Grid MinHeight="40" Padding="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:GraphRowCanvas RowData="{x:Bind}" Grid.Column="0" VerticalAlignment="Stretch" Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center" Padding="0,6">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0" ItemsSource="{x:Bind Commit.Refs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border CornerRadius="4" Padding="4,1"
                                                    Background="{Binding Converter={StaticResource RefToBackgroundConverter}}">
                                                <TextBlock Text="{x:Bind}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Column="1" Text="{x:Bind Commit.Summary}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           ToolTipService.ToolTip="{x:Bind Commit.Message}" />

                                <Border Grid.Column="2"
                                        Visibility="{x:Bind Commit.IsPendingPush, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4" Padding="5,2" Margin="4,0,4,0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Unpushed commit">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Unpushed" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Commit.AuthorName}" Style="{StaticResource GHCaptionTextStyle}" MaxLines="1" />
                                <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind Commit.RelativeDate}" Style="{StaticResource GHCaptionTextStyle}" />
                                <TextBlock Text="{x:Bind Commit.ShortHash}" FontSize="11" FontFamily="Cascadia Mono, Cascadia Code, Consolas"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Checkout" Click="Checkout_Click" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Create branch here..." Click="CreateBranch_Click" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Merge into current branch" Click="Merge_Click" Tag="{x:Bind}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete branch..." Click="DeleteBranch_Click" Tag="{x:Bind}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
