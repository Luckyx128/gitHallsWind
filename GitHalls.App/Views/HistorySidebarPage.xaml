<Page
    x:Class="GitHalls.App.Views.HistorySidebarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitHalls.Core.Models"
    x:Name="PageRoot"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Bar / Sync operations -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Download" Label="Pull" Command="{x:Bind ViewModel.PullCommand}" />
            <AppBarButton Icon="Upload" Label="{x:Bind ViewModel.PushButtonLabel, Mode=OneWay}" Command="{x:Bind ViewModel.PushCommand}" />
            <AppBarButton Icon="Sync" Label="Fetch" Command="{x:Bind ViewModel.RefreshCommand}" />
        </CommandBar>

        <!-- List of Commits -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Commit">
                    <Grid Padding="8,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Mock (Ideally use PersonPicture) -->
                        <PersonPicture Grid.Column="0" DisplayName="{x:Bind AuthorName}" Width="36" Height="36" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{x:Bind Message}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind AuthorName}" FontSize="12" Foreground="Gray" />
                                <TextBlock Text="{x:Bind Date.ToString()}" FontSize="12" Foreground="Gray" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
