<Page
    x:Class="GitHalls.App.Views.GitgraphPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls"
    xmlns:converters="using:GitHalls.App.Converters"
    xmlns:models="using:GitHalls.App.Models"
    xmlns:graph="using:GitHalls.Core.Graph">

    <Grid>
        <Grid.Resources>
            <converters:RefToBackgroundConverter x:Key="RefToBackgroundConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                      Visibility="{x:Bind ToVisibility(ViewModel.IsLoading), Mode=OneWay}" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Visibility="{x:Bind ToErrorVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />

        <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" 
                  SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single"
                  ShowsScrollingPlaceholders="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource GHCompactListItemStyle}">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="graph:GraphRow">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <controls:GraphRowCanvas RowData="{x:Bind}" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{x:Bind Commit.Refs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border CornerRadius="4" Padding="4,2" 
                                                Background="{Binding Converter={StaticResource RefToBackgroundConverter}}">
                                            <TextBlock Text="{x:Bind}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{x:Bind Commit.Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Commit.AuthorName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind Commit.RelativeDate}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                        </StackPanel>

                        <!-- Expanded Section -->
                        <Border Grid.Column="1" Grid.Row="1"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,4,12,12"
                                Padding="12">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                </TransitionCollection>
                            </Border.Transitions>
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind Commit.Message}" TextWrapping="Wrap" />
                                <TextBlock Text="Affected files:" FontWeight="SemiBold" />
                                
                                <ScrollViewer MaxHeight="300" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                                    <ItemsControl ItemsSource="{x:Bind TreeFiles, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:GitTreeFileNode">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="{x:Bind Margin}" Padding="4,4">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    
                                                    <!-- Additions and Deletions -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{x:Bind AdditionsText}" FontSize="12" Foreground="{ThemeResource GHAdditionBrush}" />
                                                        <TextBlock Text="{x:Bind DeletionsText}" FontSize="12" Foreground="{ThemeResource GHDeletionBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Checkout" Click="Checkout_Click" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Create branch here..." Click="CreateBranch_Click" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Merge into current branch" Click="Merge_Click" Tag="{x:Bind}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete branch..." Click="DeleteBranch_Click" Tag="{x:Bind}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
