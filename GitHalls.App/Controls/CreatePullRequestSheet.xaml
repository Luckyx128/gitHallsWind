<UserControl
    x:Class="GitHalls.App.Controls.CreatePullRequestSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="400" Spacing="12">
        <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="What this pull request does"
                 TextChanged="TitleBox_TextChanged" />

        <TextBox x:Name="DescriptionBox" Header="Description" PlaceholderText="Optional"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <ComboBox x:Name="BaseBox" Header="Base branch" HorizontalAlignment="Stretch" />

        <!-- Which branch is being proposed, stated where the merge dialog states
             the branch that changes: it is the easy thing to forget. -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="From" Style="{StaticResource GHCaptionTextStyle}" VerticalAlignment="Center" />
            <Border Style="{StaticResource GHChipStyle}">
                <TextBlock x:Name="HeadText" TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="240" />
            </Border>
        </StackPanel>

        <InfoBar x:Name="RemoteBar" Severity="Informational" IsOpen="False" IsClosable="False" />
    </StackPanel>
</UserControl>
