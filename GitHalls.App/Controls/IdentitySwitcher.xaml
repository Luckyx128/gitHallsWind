<UserControl
    x:Class="GitHalls.App.Controls.IdentitySwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls">

    <Grid Width="320">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Who git would credit right now, and where that came from. The scope
             is the part people get wrong. -->
        <StackPanel Grid.Row="0" Spacing="2" Padding="12,10,12,8">
            <TextBlock x:Name="CurrentAuthorText" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="ScopeText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <CheckBox x:Name="FixRemoteCheckBox" Grid.Row="1" Margin="12,0,12,4"
                  Content="Also point the remote at that account"
                  ToolTipService.ToolTip="Rewrites origin to https://username@github.com/... for identities that have a GitHub username" />

        <ListView x:Name="IdentityList" Grid.Row="2"
                  MinHeight="120" MaxHeight="260"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="IdentityList_ItemClick"
                  Style="{StaticResource GHListViewStyle}"
                  ItemContainerStyle="{StaticResource GHCompactListItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:IdentityRow">
                    <Grid Padding="0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="12" VerticalAlignment="Center"
                                  Visibility="{x:Bind CheckVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8" Padding="12,8,12,10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="0,0,8,8">
            <!-- Said plainly because it is the thing that surprises people: the
                 identity credits the commit, it does not authenticate the push. -->
            <TextBlock Text="Switching identity changes who commits are credited to, for this repository only. Pushing and fetching authenticate separately."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button x:Name="ManageButton" Content="Manage identities..." HorizontalAlignment="Stretch"
                    Click="Manage_Click" />
        </StackPanel>
    </Grid>
</UserControl>
