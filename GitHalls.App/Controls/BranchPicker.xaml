<UserControl
    x:Class="GitHalls.App.Controls.BranchPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitHalls.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterTextBox" Grid.Row="0" Margin="8,8,8,4"
                 PlaceholderText="Filter branches"
                 TextChanged="FilterTextBox_TextChanged" />

        <!-- One template for headers and branches alike: the item decides how it
             renders, which keeps the list virtualized. A repository can have
             hundreds of remote branches, and real sections would force every row
             to be materialized up front. -->
        <ListView x:Name="BranchList" Grid.Row="1"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="BranchList_ItemClick"
                  SelectionChanged="BranchList_SelectionChanged"
                  ContainerContentChanging="BranchList_ContainerContentChanging">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="10,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:BranchListItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind Text}"
                                   FontSize="{x:Bind FontSize}"
                                   FontWeight="{x:Bind FontWeight}"
                                   Foreground="{x:Bind Foreground}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Text}" />

                        <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="12"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{x:Bind CheckVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
