<Window
    x:Class="GitHalls.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHalls.App"
    xmlns:views="using:GitHalls.App.Views"
    Title="GitHalls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" /> <!-- Custom Title Bar Space -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Drag region for the Window -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" IsHitTestVisible="True">
            <TextBlock x:Name="TitleBarText" Text="GitHalls" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Grid>

        <MenuBar Grid.Row="1">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Repository..." Click="OpenRepo_Click" />
                <MenuFlyoutItem Text="Clone Repository..." Icon="Copy" Click="CloneRepo_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Branch">
                <MenuFlyoutItem Text="Merge into Current..." Click="MergeBranch_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                <MenuFlyoutItem Text="Fetch" Icon="Sync" Command="{x:Bind ViewModel.FetchCommand}" />
            </MenuBarItem>
        </MenuBar>

        <InfoBar Grid.Row="2" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 CloseButtonClick="ErrorBar_CloseButtonClick" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar column -->
            <Grid Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="MainSelectorBar" SelectionChanged="MainSelectorBar_SelectionChanged" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <SelectorBarItem x:Name="ChangesTab" Text="Changes" />
                    <SelectorBarItem x:Name="HistoryTab" Text="History" />
                </SelectorBar>

                <Frame x:Name="SidebarFrame" Grid.Row="1" />
            </Grid>

            <!-- Main Content (Diff) -->
            <Grid Grid.Column="1" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,10,0,0">
                            <DropDownButton Content="Repository">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="RepositoryFlyout" Opening="RepositoryFlyout_Opening">
                                        <MenuFlyoutItem Text="Open Repository..." Click="OpenRepo_Click" />
                                        <MenuFlyoutItem Text="Clone Repository..." Click="CloneRepo_Click" />
                                        <MenuFlyoutSeparator x:Name="RecentSeparator" Visibility="Collapsed" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <ComboBox x:Name="BranchSelector"
                                      ItemsSource="{x:Bind ViewModel.Branches, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.CurrentBranch, Mode=OneWay}"
                                      DisplayMemberPath="Name"
                                      Width="220"
                                      PlaceholderText="Select Branch..."
                                      SelectionChanged="BranchSelector_SelectionChanged" />

                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                        </StackPanel>
                    </CommandBar.Content>

                    <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                    <AppBarButton Icon="Sync" Label="Fetch" Command="{x:Bind ViewModel.FetchCommand}" />
                    <AppBarButton Icon="Shuffle" Label="Merge" Click="MergeBranch_Click" />
                    <AppBarButton Icon="More" Label="Actions">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Reveal in File Explorer" Click="RevealInExplorer_Click" />
                                <MenuFlyoutItem Text="Open in Terminal" Click="OpenTerminal_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
