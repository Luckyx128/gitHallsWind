<Window
    x:Class="GitHalls.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GitHalls.App.Converters"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="GitHalls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleSidebarAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenRepoAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" /> <!-- Custom Title Bar Space -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Drag region for the Window -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" IsHitTestVisible="True">
            <TextBlock x:Name="TitleBarText" Text="GitHalls" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Grid>

        <!-- The MenuBar that used to sit here only duplicated the toolbar
             (Open/Clone in the Repository button, Merge, Refresh, Fetch, Toggle
             Sidebar). Its keyboard shortcuts are declared on the root Grid. -->

        <InfoBar Grid.Row="1" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 CloseButtonClick="ErrorBar_CloseButtonClick" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- min/max mirror the Swift navigationSplitViewColumnWidth(min:ideal:) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar column -->
            <Grid x:Name="Sidebar" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="MainSelectorBar" SelectionChanged="MainSelectorBar_SelectionChanged" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <SelectorBarItem x:Name="ChangesTab" Text="Changes" />
                    <SelectorBarItem x:Name="HistoryTab" Text="History" />
                </SelectorBar>

                <Frame x:Name="SidebarFrame" Grid.Row="1" />
            </Grid>

            <toolkit:GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                                  Width="8" ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment"
                                  Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Main Content (Diff) -->
            <Grid Grid.Column="2" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0" Height="48">
                            <Button x:Name="ToggleSidebarButton" Click="ToggleSidebar_Click"
                                    Content="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Width="36" Height="32" Padding="0"
                                    ToolTipService.ToolTip="Toggle sidebar (Ctrl+B)" />

                            <!-- Repository and branch are the same control, built the
                                 same way, so they line up and open the same. -->
                            <DropDownButton x:Name="RepositoryButton" Height="32" MinWidth="150" MaxWidth="260"
                                            HorizontalContentAlignment="Left">
                                <TextBlock x:Name="RepositoryButtonText" Text="Open Repository"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="RepositoryFlyout" Opening="RepositoryFlyout_Opening" Placement="Bottom">
                                        <MenuFlyoutItem Text="Open Repository..." Click="OpenRepo_Click" />
                                        <MenuFlyoutItem Text="Clone Repository..." Click="CloneRepo_Click" />
                                        <MenuFlyoutSeparator x:Name="RecentSeparator" Visibility="Collapsed" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton x:Name="BranchButton" Height="32" MinWidth="150" MaxWidth="260"
                                            HorizontalContentAlignment="Left">
                                <TextBlock x:Name="BranchButtonText" Text="Branch"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="BranchFlyout" Opening="BranchFlyout_Opening" Placement="Bottom" />
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <!-- One button whose label states what is actually needed:
                                 Push (N) / Pull (N) / Publish Branch / Up to date.
                                 Port of SyncButton.swift. -->
                            <Button x:Name="SyncButton" Height="32" MinWidth="130"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Bind ViewModel.SyncCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14"
                                              Glyph="{x:Bind ViewModel.SyncGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SyncTitle, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button Content="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Width="36" Height="32" Padding="0"
                                    Command="{x:Bind ViewModel.FetchCommand}"
                                    ToolTipService.ToolTip="Fetch from remote" />

                            <ProgressRing Width="18" Height="18"
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </CommandBar.Content>

                    <AppBarButton Icon="Refresh" LabelPosition="Collapsed" ToolTipService.ToolTip="Refresh (Ctrl+R)" Command="{x:Bind ViewModel.RefreshCommand}" />
                    <AppBarButton Icon="Shuffle" LabelPosition="Collapsed" ToolTipService.ToolTip="Merge into current branch" Click="MergeBranch_Click" />
                    <AppBarButton Icon="More" LabelPosition="Collapsed" ToolTipService.ToolTip="Repository actions">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Reveal in File Explorer" Click="RevealInExplorer_Click" />
                                <MenuFlyoutItem Text="Open in Terminal" Click="OpenTerminal_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
