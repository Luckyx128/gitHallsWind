<Window
    x:Class="GitHalls.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GitHalls.App.Converters"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="GitHalls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" /> <!-- Custom Title Bar Space -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Drag region for the Window -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" IsHitTestVisible="True">
            <TextBlock x:Name="TitleBarText" Text="GitHalls" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Grid>

        <MenuBar Grid.Row="1">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Repository..." Click="OpenRepo_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Clone Repository..." Icon="Copy" Click="CloneRepo_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Branch">
                <MenuFlyoutItem Text="Merge into Current..." Click="MergeBranch_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Toggle Sidebar" Click="ToggleSidebar_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Fetch" Icon="Sync" Command="{x:Bind ViewModel.FetchCommand}" />
            </MenuBarItem>
        </MenuBar>

        <InfoBar Grid.Row="2" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 CloseButtonClick="ErrorBar_CloseButtonClick" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- min/max mirror the Swift navigationSplitViewColumnWidth(min:ideal:) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar column -->
            <Grid x:Name="Sidebar" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="MainSelectorBar" SelectionChanged="MainSelectorBar_SelectionChanged" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <SelectorBarItem x:Name="ChangesTab" Text="Changes" />
                    <SelectorBarItem x:Name="HistoryTab" Text="History" />
                </SelectorBar>

                <Frame x:Name="SidebarFrame" Grid.Row="1" />
            </Grid>

            <toolkit:GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                                  Width="8" ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment"
                                  Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Main Content (Diff) -->
            <Grid Grid.Column="2" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0" DefaultLabelPosition="Collapsed" Background="Transparent" IsOpen="False">
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0" Height="48">
                            <Button x:Name="ToggleSidebarButton" Click="ToggleSidebar_Click"
                                    Content="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Width="36" Height="32" Padding="0"
                                    ToolTipService.ToolTip="Toggle sidebar (Ctrl+B)" />

                            <!-- Repository and branch are the same control, built the
                                 same way, so they line up and open the same. -->
                            <DropDownButton x:Name="RepositoryButton" Height="32" MinWidth="150" MaxWidth="260"
                                            HorizontalContentAlignment="Left">
                                <TextBlock x:Name="RepositoryButtonText" Text="Open Repository"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="RepositoryFlyout" Opening="RepositoryFlyout_Opening" Placement="Bottom">
                                        <MenuFlyoutItem Text="Open Repository..." Click="OpenRepo_Click" />
                                        <MenuFlyoutItem Text="Clone Repository..." Click="CloneRepo_Click" />
                                        <MenuFlyoutSeparator x:Name="RecentSeparator" Visibility="Collapsed" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton x:Name="BranchButton" Height="32" MinWidth="150" MaxWidth="260"
                                            HorizontalContentAlignment="Left">
                                <TextBlock x:Name="BranchButtonText" Text="Branch"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="BranchFlyout" Opening="BranchFlyout_Opening" Placement="Bottom" />
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <ProgressRing Width="18" Height="18"
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </CommandBar.Content>

                    <!-- Sync lives here, not in the History sidebar: it acts on the
                         repository as a whole, like the Swift toolbar SyncButton.
                         Icon-only with tooltips, except Push — its label is the one
                         that changes ("Publish Branch"), so it stays readable. -->
                    <AppBarButton Icon="Sync" ToolTipService.ToolTip="Fetch" Command="{x:Bind ViewModel.FetchCommand}" />
                    <AppBarButton Icon="Download" ToolTipService.ToolTip="Pull" Command="{x:Bind ViewModel.PullCommand}" />
                    <AppBarButton Icon="Upload" LabelPosition="Right"
                                  Label="{x:Bind ViewModel.PushButtonLabel, Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.PushButtonLabel, Mode=OneWay}"
                                  Command="{x:Bind ViewModel.PushCommand}" />
                    <AppBarSeparator />
                    <AppBarButton Icon="Refresh" ToolTipService.ToolTip="Refresh (Ctrl+R)" Command="{x:Bind ViewModel.RefreshCommand}" />
                    <AppBarButton Icon="Shuffle" ToolTipService.ToolTip="Merge into current branch" Click="MergeBranch_Click" />
                    <AppBarButton Icon="More" ToolTipService.ToolTip="Repository actions">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Reveal in File Explorer" Click="RevealInExplorer_Click" />
                                <MenuFlyoutItem Text="Open in Terminal" Click="OpenTerminal_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
